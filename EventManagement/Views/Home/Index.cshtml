@model IEnumerable<EventManagement.Models.Event>

@{
    ViewBag.Title = "Trang chủ - Danh sách Sự kiện";
}

<div class="p-5 mb-5 rounded-3 text-center position-relative"
     style="background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('https://images.unsplash.com/photo-1492684223066-81342ee5ff30?q=80&w=2070') no-repeat center center; background-size: cover; color: white; margin-top: -1.5rem;">
    <div class="py-5">
        <h1 class="fw-bold display-4 mb-3" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">HỆ THỐNG ĐẶT VÉ SỰ KIỆN HUFLIT</h1>
        <p class="lead mb-4" style="font-size: 1.25rem;">Khám phá và đăng ký tham gia các hội thảo, sự kiện hấp dẫn nhất</p>
        <a href="#event-list" class="btn btn-warning btn-lg fw-bold px-4 rounded-pill">Khám phá ngay</a>
    </div>
</div>
<!-- Thêm id này vào div row chứa ô tìm kiếm để nút "Khám phá ngay" cuộn xuống tới đây -->
<div id="event-list"></div>


@using (Html.BeginForm("Index", "Home", FormMethod.Get, new { @class = "row g-3 mb-4 p-3 bg-light rounded border" }))
{
    <div class="col-md-5">
        <input type="text" name="searchString" value="@ViewBag.CurrentFilter" class="form-control" placeholder="Nhập tên sự kiện hoặc địa điểm..." />
    </div>
    <div class="col-md-4">
        @Html.DropDownList("categoryId", (SelectList)ViewBag.CategoryID, "-- Tất cả danh mục --", new { @class = "form-select form-control" })
    </div>
    <div class="col-md-3 d-grid">
        <button type="submit" class="btn btn-primary">Tìm kiếm / Lọc</button>
    </div>
}


<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <h4 class="text-muted">Không tìm thấy sự kiện nào phù hợp.</h4>
        </div>
    }
    else
    {
        foreach (var item in Model)
        {
            
            var now = DateTime.Now;
            string statusText = "Sắp diễn ra";
            string statusBadgeClass = "bg-primary"; // Màu xanh dương

            if (item.EndDate.HasValue && now > item.EndDate.Value)
            {
                statusText = "Đã kết thúc";
                statusBadgeClass = "bg-danger"; // Màu đỏ
            }
            else if (item.StartDate.HasValue && now >= item.StartDate.Value)
            {
                
                if ((item.EndDate.HasValue && now <= item.EndDate.Value) || (!item.EndDate.HasValue && now.Date == item.StartDate.Value.Date))
                {
                    statusText = "Đang diễn ra";
                    statusBadgeClass = "bg-success"; // Màu xanh lá
                }
                else
                {
                    statusText = "Đã kết thúc";
                    statusBadgeClass = "bg-secondary"; // Màu xám
                }
            }

            <div class="col-md-4 mb-4">
                
                <div class="card h-100 shadow-sm position-relative">

                    
                    <span class="badge @statusBadgeClass position-absolute top-0 end-0 m-2 px-3 py-2 shadow"
                          style="z-index: 10; font-size: 0.85rem; border-radius: 20px;">
                        @statusText
                    </span>

                    @if (!string.IsNullOrEmpty(item.Image))
                    {
                        <img src="~/Content/images/@item.Image" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span>Chưa có ảnh</span>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-info text-dark mb-2" style="width: fit-content;">
                            @(item.Category != null ? item.Category.CategoryName : "Sự kiện")
                        </span>
                        <h5 class="card-title fw-bold">@item.Title</h5>
                        <p class="card-text text-muted mb-1">
                            <strong>Địa điểm:</strong> @item.Location
                        </p>
                        <p class="card-text text-muted mb-1">
                            <strong>Thời gian:</strong> @(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy HH:mm") : "Đang cập nhật")
                        </p>
                        <p class="card-text text-muted mb-2">
                            <strong>Số vé còn lại:</strong> @item.TotalTickets
                        </p>
                        <h5 class="text-danger fw-bold mt-auto">
                            @(item.TicketPrice > 0 ? string.Format("{0:N0} VNĐ", item.TicketPrice) : "Miễn phí")
                        </h5>
                        <a href="@Url.Action("Details", "Home", new { id = item.EventID })" class="btn btn-outline-primary mt-2 w-100">
                            Xem chi tiết & Đặt vé
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>
</div>