@model IEnumerable<EventManagement.Models.Booking>

@{
    ViewBag.Title = "Vé của tôi";
}

<div class="container mt-4">
    <h2 class="mb-3 fw-bold">Danh sách vé đã đặt của tôi</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success fw-bold">
            @TempData["Success"]
        </div>
    }

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Sự kiện</th>
                <th>Ngày đặt</th>
                <th>Số lượng</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-3">Bạn chưa đặt vé sự kiện nào.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@(item.Event != null ? item.Event.Title : "")</strong></td>
                        <td>@(item.BookingDate.HasValue ? item.BookingDate.Value.ToString("dd/MM/yyyy HH:mm") : "")</td>
                        <td>@item.Quantity</td>
                        <td>@(item.TotalPrice.HasValue ? string.Format("{0:N0} VNĐ", item.TotalPrice) : "0 VNĐ")</td>
                        <td>
                            @if (item.Status == "Approved")
                            {
                                <span class="badge bg-success">Đã duyệt (Approved)</span>
                            }
                            else if (item.Status == "Cancelled")
                            {
                                <span class="badge bg-danger">Đã hủy (Cancelled)</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Chờ duyệt (@item.Status)</span>
                            }
                        </td>
                        <td>
                            @if (item.Status != "Cancelled")
                            {
                                using (Html.BeginForm("CancelTicket", "Bookings", FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.BookingID" />
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Bạn muốn hủy vé này?');">
                                        Hủy vé
                                    </button>
                                }
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    @if (ViewBag.TotalSpent != null)
    {
        <div class="text-end mt-3">
            <h4 class="fw-bold text-danger">
                Tổng tiền đã chi: @string.Format("{0:N0}", ViewBag.TotalSpent) VNĐ
            </h4>
        </div>
    }
</div>