@model EventManagement.Models.Account

@{
    ViewBag.Title = "Đăng ký tài khoản";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <h2>Đăng ký tài khoản</h2>
        <hr />

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("Register", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group mb-3">
                <label>Tên đăng nhập:</label>
                @Html.TextBoxFor(m => m.Username, new { @class = "form-control", required = "required" })
            </div>

            <div class="form-group mb-3">
                <label>Mật khẩu:</label>
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", required = "required" })
            </div>

            <div class="form-group mb-3">
                <label>Họ và tên:</label>
                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", required = "required" })
            </div>

            <div class="form-group mb-3">
                <label>Email:</label>
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
            </div>

            <button type="submit" class="btn btn-primary">Đăng ký ngay</button>
            <a href="@Url.Action("Login", "Account")" class="btn btn-link">Đã có tài khoản? Đăng nhập</a>
        }
    </div>
</div>