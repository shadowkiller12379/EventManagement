@model EventManagement.Models.Event

@{
    ViewBag.Title = "Details";
}


<div style="margin: 10px auto; width: 70%;">
    <h2 style="text-align: center">CHI TIẾT SỰ KIỆN</h2>
    <div>
        <hr />

        <dl class="dl-horizontal">
            <dt>
                TÊN SỰ KIỆN
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Title)
            </dd>

            <dt>
               MÔ TẢ
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Description)
            </dd>

            <dt>
                HÌNH ẢNH
            </dt>

            <dd>
               
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <div class="mb-2">
                        <img src="~/Content/images/@Model.Image" alt="Ảnh hiện tại" class="img-thumbnail" style="max-height: 150px; object-fit: cover;" />
                        
                    </div>
                }
                else
                {
                    <div class="mb-2 text-muted fst-italic">Sự kiện chưa có ảnh</div>
                }
                @Html.ValidationMessageFor(model => model.Image, "", new { @class = "text-danger" })
            </dd>

            <dt>
                ĐỊA CHỈ
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Location)
            </dd>

            <dt>
               THỜI GIAN BẮT ĐẦU
            </dt>

            <dd>
                @Html.DisplayFor(model => model.StartDate)
            </dd>

            <dt>
                THỜI GIAN KẾT THÚC
            </dt>

            <dd>
                @Html.DisplayFor(model => model.EndDate)
            </dd>

            <dt>
                GIÁ VÉ
            </dt>

            <dd>
                @Html.DisplayFor(model => model.TicketPrice)
            </dd>

            <dt>
                TỔNG SỐ VÉ
            </dt>

            <dd>
                @Html.DisplayFor(model => model.TotalTickets)
            </dd>

            <dt>
                LOẠI SỰ KIỆN
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Category.CategoryName)
            </dd>

        </dl>

    </div>
    <p>
        @Html.ActionLink("Edit", "Edit", new { id = Model.EventID }, new
        {
            @class
             = "btn btn-success"
        }) |
        @Html.ActionLink("TRỞ LẠI", "Index")
    </p>
</div>