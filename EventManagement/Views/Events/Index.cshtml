@model IEnumerable<EventManagement.Models.Event>

@{
    ViewBag.Title = "Index";
}


<div style="margin: 10px auto; width: 100%;">
    <h2 style="text-align: center">
        THÔNG TIN SỰ KIỆN
    </h2>
    <p>
        @Html.ActionLink("TẠO MỚI", "Create", null, new
        {
            @class = "btn btn-primary"
        })
    </p>
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>TÊN SỰ KIỆN</th>
                <th>MÔ TẢ</th>
                <th>HÌNH ẢNH</th>
                <th>ĐỊA ĐIỂM</th>
                <th>THỜI GIAN BẮT ĐẦU</th>
                <th>THỜI GIAN KẾT THÚC</th>
                <th>GIÁ VÉ</th>
                <th>TỔNG SỐ VÉ</th>
                <th>LOẠI SỰ KIỆN</th>
                <th>THAO TÁC</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-3">Chưa có sự kiện nào.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Title</strong></td>
                        <td>@item.Description</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <img src="~/Content/images/@item.Image" alt="@item.Title" style="width: 80px; height: 60px; object-fit: cover;" />
                            }
                            else
                            {
                                <span class="text-muted">Chưa có ảnh</span>
                            }
                        </td>
                        <td>@item.Location</td>
                        <td>@(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy HH:mm") : "")</td>
                        <td>@(item.EndDate.HasValue ? item.EndDate.Value.ToString("dd/MM/yyyy HH:mm") : "")</td>
                        <td>@(item.TicketPrice > 0 ? string.Format("{0:N0} VNĐ", item.TicketPrice) : "Miễn phí")</td>
                        <td>@item.TotalTickets</td>
                        <td>@(item.Category != null ? item.Category.CategoryName : "")</td>
                        <td class="text-nowrap">
                            @Html.ActionLink("Sửa", "Edit", new { id = item.EventID }, new { @class = "btn btn-success btn-sm" })
                            @Html.ActionLink("Chi tiết", "Details", new { id = item.EventID }, new { @class = "btn btn-primary btn-sm" })
                            @Html.ActionLink("Xóa", "Delete", new { id = item.EventID }, new { @class = "btn btn-danger btn-sm" })
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>