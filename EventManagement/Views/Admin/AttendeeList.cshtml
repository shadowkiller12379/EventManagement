@model IEnumerable<EventManagement.Models.Booking>
@{
    ViewBag.Title = "Danh sách người tham dự";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Danh sách người tham dự</h2>

@using (Html.BeginForm("AttendeeList", "Admin", FormMethod.Get))
{
    <div class="mb-3">
        <label for="eventId">Sự kiện:</label>
        @Html.DropDownList("eventId", (SelectList)ViewBag.Events, "-- Tất cả sự kiện --", new { @class = "form-control" })
    </div>
    <button type="submit" class="btn btn-primary mb-3">Lọc</button>
}

<table class="table table-bordered table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Tên sự kiện</th>
            <th>Số lượng vé</th>
            <th>Ngày đặt</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-3">Chưa có lượt đặt vé nào.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td><strong>@(item.Account != null ? item.Account.FullName : "")</strong></td>
                    <td>@(item.Account != null ? item.Account.Email : "")</td>
                    <td>@(item.Event != null ? item.Event.Title : "")</td>
                    <td>@item.Quantity</td>
                    <td>@(item.BookingDate.HasValue ? item.BookingDate.Value.ToString("dd/MM/yyyy HH:mm") : "")</td>
                    <td>
                        @if (item.Status == "Approved")
                        {
                            <span class="badge bg-success">Đã duyệt (Approved)</span>
                        }
                        else if (item.Status == "Cancelled")
                        {
                            <span class="badge bg-danger">Đã hủy (Cancelled)</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Chờ duyệt (@item.Status)</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        @using (Html.BeginForm("UpdateStatus", "Admin", FormMethod.Post, new { style = "display:inline" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.BookingID" />
                            <input type="hidden" name="returnUrl" value="@Request.Url.PathAndQuery" />
                            <button type="submit" name="status" value="Approved" class="btn btn-success btn-sm">Duyệt</button>
                            <button type="submit" name="status" value="Cancelled" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Hủy vé này?');">
                                Hủy
                            </button>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>