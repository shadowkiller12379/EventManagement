@model IEnumerable<EventManagement.Models.Booking>
@{
    ViewBag.Title = "Danh sách đặt vé";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Danh sách đơn đặt vé</h2>

<table class="table table-bordered table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>Sự kiện</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Số lượng vé</th>
            <th>Ngày đặt</th>
            <th>Trạng thái</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-3">Chưa có lượt đặt vé nào.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td><strong>@(item.Event != null ? item.Event.Title : "")</strong></td>
                    <td>@(item.Account != null ? item.Account.FullName : "")</td>
                    <td>@(item.Account != null ? item.Account.Email : "")</td>
                    <td>@item.Quantity</td>
                    <td>@(item.BookingDate.HasValue ? item.BookingDate.Value.ToString("dd/MM/yyyy HH:mm") : "")</td>
                    <td>
                        @if (item.Status == "Approved")
                        {
                            <span class="badge bg-success">Đã duyệt (Approved)</span>
                        }
                        else if (item.Status == "Cancelled")
                        {
                            <span class="badge bg-danger">Đã hủy (Cancelled)</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Chờ duyệt (@item.Status)</span>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>